{
  "name": "claude-monitor",
  "version": "0.5.0",
  "description": "Claude Code session monitor — one row per session, real titles, transcript-derived status (fork of ibrahimokdadov/claudeMonitor)",
  "main": "monitor.js",
  "bin": {
    "claude-monitor": "monitor.js"
  },
  "scripts": {
    "start": "node monitor.js",
    "once": "node monitor.js --once",
    "all": "node monitor.js --once --all",
    "test": "node test/run.js",
    "probe": "node scripts/probe.js",
    "themes": "node monitor.js --themes",
    "fields": "node scripts/probe-fields.js",
    "config": "node scripts/config.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/uninstall-hooks.js"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "private": true
}
